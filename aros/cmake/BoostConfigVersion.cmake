# Version file for the AROS Boost shim; read the version from boost/version.hpp.
set(_boost_v "${CMAKE_SYSROOT}/include/boost/version.hpp")
set(PACKAGE_VERSION "0.0.0")
if(EXISTS "${_boost_v}")
    file(STRINGS "${_boost_v}" _line REGEX "^#define BOOST_VERSION[ \t]+[0-9]+")
    string(REGEX REPLACE ".*[ \t]([0-9]+)$" "\\1" _num "${_line}")
    if(_num)
        math(EXPR _maj "${_num} / 100000")
        math(EXPR _min "(${_num} / 100) % 1000")
        math(EXPR _pat "${_num} % 100")
        set(PACKAGE_VERSION "${_maj}.${_min}.${_pat}")
    endif()
endif()
if(PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    if(PACKAGE_VERSION VERSION_EQUAL PACKAGE_FIND_VERSION)
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
endif()
