# Version file for the AROS SDL2 shim; read the real version from the headers.
set(_sdl2_h "${CMAKE_SYSROOT}/include/SDL2/SDL_version.h")
if(EXISTS "${_sdl2_h}")
    file(STRINGS "${_sdl2_h}" _maj REGEX "^#define SDL_MAJOR_VERSION[ \t]+[0-9]+")
    file(STRINGS "${_sdl2_h}" _min REGEX "^#define SDL_MINOR_VERSION[ \t]+[0-9]+")
    file(STRINGS "${_sdl2_h}" _pat REGEX "^#define SDL_PATCHLEVEL[ \t]+[0-9]+")
    string(REGEX REPLACE ".*[ \t]([0-9]+)$" "\\1" _maj "${_maj}")
    string(REGEX REPLACE ".*[ \t]([0-9]+)$" "\\1" _min "${_min}")
    string(REGEX REPLACE ".*[ \t]([0-9]+)$" "\\1" _pat "${_pat}")
    set(PACKAGE_VERSION "${_maj}.${_min}.${_pat}")
else()
    set(PACKAGE_VERSION "2.32.0")
endif()
if(PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    if(PACKAGE_VERSION VERSION_EQUAL PACKAGE_FIND_VERSION)
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
endif()
